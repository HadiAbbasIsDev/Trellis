{
  "name": "trellis",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first memory graph for coding agents — Obsidian-compatible markdown vault served over MCP",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "seed": "tsx scripts/seed.ts",
    "graph": "tsx scripts/graph.ts",
    "wire": "node scripts/wire.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "eval": "tsx packages/eval/src/run.ts",
    "eval:gen": "tsx packages/eval/src/gen.ts",
    "selftest:hooks": "node scripts/hooks/selftest.mjs",
    "ext:build": "node packages/vscode-ext/build.mjs",
    "ext:package": "npm --prefix packages/vscode-ext exec @vscode/vsce -- package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
